<?php

/**
 * @file
 * User feedback.
 */

use Drupal\user_feedback\EventListener\UserFeedbackListener;

/**
 * Implements hook_theme().
 */
function user_feedback_theme(array $existing, string $type, string $theme, string $path): array {
  return \Drupal::service(UserFeedbackListener::class)->theme($existing, $type, $theme, $path);
}
